# /etc/getlawtext/getlawtext.env   (권한: chmod 600, 소유자 root)
# 값에 따옴표를 쓰지 마세요. 줄 끝 공백도 넣지 마세요.

# [필수] 법제처 Open API 인증키(OC) — open.law.go.kr 가입 이메일의 @ 앞부분
LAW_OC=

# [권장] MCP 접속 키 — 쉼표로 여러 개. 비우면 인증 없이 동작
#   만들기 예: openssl rand -hex 32
MCP_API_KEY=

# [선택] Host 헤더 검사 — 리버스 프록시의 외부 도메인 (예: law.example.go.kr). 비우면 검사 안 함
MCP_ALLOWED_HOSTS=

# [선택] law.go.kr 로 나갈 때 사내 프록시를 거쳐야 하면 지정
# HTTPS_PROXY=http://proxy.example.go.kr:3128
# NO_PROXY=127.0.0.1,localhost

# [선택] law.go.kr 대신 내부 중계 주소를 쓸 때
# LAW_API_BASE=https://www.law.go.kr/DRF
# LAW_TIMEOUT=20
